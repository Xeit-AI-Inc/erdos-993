/-! ## §2 — THE SHADOW DOUBLE COUNT (CLAIM-C4-1, CLAIM-C4-2 — the fourth
representation layer, new this cycle) -/

/-- **PROVED (helper): `IndepSet` is downward closed.** A subset of an
independent set is independent. Literal membership bookkeeping. -/
theorem indepSet_subset (t : RTree) {S T : Finset (List ℕ)}
    (hS : t.IndepSet S) (hTS : T ⊆ S) : t.IndepSet T :=
  ⟨hTS.trans hS.1, fun u hu w hw => hS.2 u (hTS hu) w (hTS hw)⟩

/-- **PROVED (CLAIM-C4-1) — LOCAL LYM FOR THE INDEPENDENCE FAMILY, the
shadow double count, premise-free, for EVERY ambient set and EVERY rank:**

`(j+1) · i_{j+1}(V) ≤ (|V| − j) · i_j(V)`.

Count the pairs `(S, T)` — `S` an independent `(j+1)`-subset of `V`, `T`
one of its `j`-element shadows — two ways. Every such `S` has exactly
`j+1` shadows `S.erase w`, each independent (downward closure), each of
size `j`: at least `j+1` pairs per `S` (the erase map is the SAME literal
injection the C3 S5 award used, applied one level down). Every independent
`j`-set `T` extends upward to at most `|V| − j` such `S` (each is
`insert w T` for some `w ∈ V ∖ T`): at most `|V| − j` pairs per `T`. The
consumed Mathlib bipartite double-counting lemma does the rest. No
sequence-shape input, no crossing index, no premise. -/
theorem succ_mul_indepCountOn_le (t : RTree) (V : Finset (List ℕ)) (j : ℕ) :
    (j + 1) * t.indepCountOn V (j + 1) ≤ (V.card - j) * t.indepCountOn V j := by
  have key :
      (V.powerset.filter (fun S => t.IndepSet S ∧ S.card = j + 1)).card * (j + 1) ≤
        (V.powerset.filter (fun S => t.IndepSet S ∧ S.card = j)).card * (V.card - j) := by
    refine Finset.card_mul_le_card_mul (fun S T => T ⊆ S) ?_ ?_
    · -- every independent (j+1)-set has at least j+1 shadows below it
      intro S hS
      rw [Finset.mem_filter, Finset.mem_powerset] at hS
      obtain ⟨hSV, hSind, hScard⟩ := hS
      have himg : S.image (fun z => S.erase z) ⊆
          (V.powerset.filter (fun S' => t.IndepSet S' ∧ S'.card = j)).bipartiteAbove
            (fun S' T => T ⊆ S') S := by
        intro T hT
        rw [Finset.mem_image] at hT
        obtain ⟨z, hz, rfl⟩ := hT
        rw [Finset.mem_bipartiteAbove]
        refine ⟨?_, Finset.erase_subset z S⟩
        rw [Finset.mem_filter, Finset.mem_powerset]
        exact ⟨(Finset.erase_subset z S).trans hSV,
          t.indepSet_subset hSind (Finset.erase_subset z S),
          by rw [Finset.card_erase_of_mem hz, hScard]; rfl⟩
      have hinj : Set.InjOn (fun z => S.erase z) S := by
        intro a ha b hb hab
        have hab' : S.erase a = S.erase b := hab
        by_contra hne
        have hmem : b ∈ S.erase a := Finset.mem_erase.mpr ⟨fun h => hne h.symm, hb⟩
        rw [hab'] at hmem
        exact (Finset.mem_erase.mp hmem).1 rfl
      calc j + 1 = S.card := hScard.symm
        _ = (S.image (fun z => S.erase z)).card :=
            (Finset.card_image_of_injOn hinj).symm
        _ ≤ _ := Finset.card_le_card himg
    · -- every independent j-set extends to at most |V| − j sets above it
      intro T hT
      rw [Finset.mem_filter, Finset.mem_powerset] at hT
      obtain ⟨hTV, _hTind, hTcard⟩ := hT
      have hsub : (V.powerset.filter (fun S => t.IndepSet S ∧ S.card = j + 1)).bipartiteBelow
          (fun S T' => T' ⊆ S) T ⊆ (V \ T).image (fun w => insert w T) := by
        intro S hS
        rw [Finset.mem_bipartiteBelow] at hS
        obtain ⟨hSs, hTS⟩ := hS
        rw [Finset.mem_filter, Finset.mem_powerset] at hSs
        obtain ⟨hSV, _hSind, hScard⟩ := hSs
        obtain ⟨w, hwS, hwT⟩ :=
          Finset.exists_mem_notMem_of_card_lt_card
            (by rw [hTcard, hScard]; omega : T.card < S.card)
        have hins : insert w T ⊆ S := Finset.insert_subset hwS hTS
        have hSeq : insert w T = S :=
          Finset.eq_of_subset_of_card_le hins
            (by rw [hScard, Finset.card_insert_of_notMem hwT, hTcard])
        rw [Finset.mem_image]
        exact ⟨w, Finset.mem_sdiff.mpr ⟨hSV hwS, hwT⟩, hSeq⟩
      calc ((V.powerset.filter (fun S => t.IndepSet S ∧ S.card = j + 1)).bipartiteBelow
            (fun S T' => T' ⊆ S) T).card
          ≤ ((V \ T).image (fun w => insert w T)).card := Finset.card_le_card hsub
        _ ≤ (V \ T).card := Finset.card_image_le
        _ = V.card - j := by rw [Finset.card_sdiff_of_subset hTV, hTcard]
  unfold RTree.indepCountOn
  calc (j + 1) * (V.powerset.filter (fun S => t.IndepSet S ∧ S.card = j + 1)).card
      = (V.powerset.filter (fun S => t.IndepSet S ∧ S.card = j + 1)).card * (j + 1) :=
        Nat.mul_comm _ _
    _ ≤ (V.powerset.filter (fun S => t.IndepSet S ∧ S.card = j)).card * (V.card - j) := key
    _ = (V.card - j) * (V.powerset.filter (fun S => t.IndepSet S ∧ S.card = j)).card :=
        Nat.mul_comm _ _

/-- **PROVED (CLAIM-C4-2) — UPPER-HALF DESCENT, premise-free:** on any
ambient set with `|V| ≤ 2j+1`, the count sequence cannot rise at rank `j`:
`Δ_j(V) ≤ 0`. From the shadow bound, `(j+1)·i_{j+1} ≤ (|V|−j)·i_j ≤
(j+1)·i_j`, and the positive factor cancels. Cardinality arithmetic only —
no unimodality, no crossing index, no premise, valid for arbitrary
graphs. -/
theorem DeltaOn_nonpos_of_card_le_two_mul (t : RTree) (V : Finset (List ℕ)) {j : ℕ}
    (h : V.card ≤ 2 * j + 1) : t.DeltaOn V j ≤ 0 := by
  have key := t.succ_mul_indepCountOn_le V j
  have h2 : (j + 1) * t.indepCountOn V (j + 1) ≤ (j + 1) * t.indepCountOn V j :=
    key.trans (Nat.mul_le_mul (by omega) (le_refl _))
  have h3 : t.indepCountOn V (j + 1) ≤ t.indepCountOn V j :=
    Nat.le_of_mul_le_mul_left h2 (by omega)
  unfold RTree.DeltaOn
  omega

/-! ## §3 — THE BAND CLOSURE (CLAIM-C4-3, CLAIM-C4-4, CLAIM-C4-5 — new
