theorem ambientInstance_of_order_le_two_mul (t : RTree) {v : List ℕ}
    (hv : v ∈ t.leaves) {g : List ℕ} (hOther : t.OtherNbr (t.support v) v g)
    {p : ℕ} (hk : K_A t p = 1)
    (hhyp : t.Bgen v (p : ℤ) +
      t.DeltaOnZ ((t.vertices \ t.closedNbhd v).erase g) ((p : ℤ) - 1) < 0)
    (horder : t.vertices.card ≤ 2 * p) :
