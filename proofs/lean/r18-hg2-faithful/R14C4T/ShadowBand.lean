theorem residual_nonpos_of_card_le_band (t : RTree) (v g : List ℕ) {p : ℕ}
    (hp : 2 ≤ p) (hcard : (t.ResidualAmbient v g).card ≤ 2 * p - 3) :
    t.DeltaOnZ (t.ResidualAmbient v g) ((p : ℤ) - 2) ≤ 0 := by
  obtain ⟨k, rfl⟩ : ∃ k, p = k + 2 := ⟨p - 2, by omega⟩
  have hc : ((k + 2 : ℕ) : ℤ) - 2 = (k : ℤ) := by push_cast; ring
  rw [hc, t.DeltaOnZ_natCast]
  exact t.DeltaOn_nonpos_of_card_le_two_mul _ (by omega)

/-- **PROVED (CLAIM-C4-4): the band CLOSES THE INSTANCE, premise-free.**
With the antecedent in hand, `D ≤ 0` closes via the consumed C1
sufficiency. -/
theorem ambientInstance_of_card_le_band (t : RTree) {v : List ℕ}
    (hv : v ∈ t.leaves) {g : List ℕ} (hOther : t.OtherNbr (t.support v) v g)
    {p : ℕ} (hk : K_A t p = 1)
    (hhyp : t.Bgen v (p : ℤ) +
      t.DeltaOnZ ((t.vertices \ t.closedNbhd v).erase g) ((p : ℤ) - 1) < 0)
    (hcard : (t.ResidualAmbient v g).card ≤ 2 * p - 3) :
    t.Bgen v (p : ℤ) + t.Bgen v ((p : ℤ) - 1) < 0 := by
  have hp2 := t.two_le_of_K_A_eq_one hk
  exact t.ambientInstance_of_residual_nonpos hv hOther (by omega) hhyp
    (t.residual_nonpos_of_card_le_band v g hp2 hcard)

/-- **PROVED (CLAIM-C4-5) — THE G2-BAND PINCH:** on `G2 ∧ |U| ≤ 2p−3` the
residual is EXACTLY zero — the governed forced sign from below, the shadow
bound from above. Premise-free. (Cross-link, stated for the record: under
