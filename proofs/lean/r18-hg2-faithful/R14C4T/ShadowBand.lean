theorem residual_eq_zero_of_card_le_band_on_G2 (t : RTree) (v g : List ℕ) {p : ℕ}
    (hp : 2 ≤ p) (hcard : (t.ResidualAmbient v g).card ≤ 2 * p - 3)
    (hx : p - 2 < t.crossingIndexOn (t.ResidualAmbient v g)) :
    t.DeltaOnZ (t.ResidualAmbient v g) ((p : ℤ) - 2) = 0 :=
