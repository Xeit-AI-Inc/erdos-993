    "theorem_name": "e993_center_subset_coeff",
    "definitions": [
      {
        "name": "def-product",
        "canonical": "e993CenterProduct s r is the finite product over i in s of ((1+X)^(r i)+X), in Polynomial Nat."
      }
    ],
    "domains": [
      {
        "variable": "ι",
        "lean_type": "Type u",
        "forbidden_narrowings": []
      },
      {
        "variable": "s",
        "lean_type": "Finset ι",
        "forbidden_narrowings": []
      },
      {
        "variable": "r",
        "lean_type": "ι → Nat",
        "forbidden_narrowings": []
      },
      {
        "variable": "k",
        "lean_type": "Nat",
        "forbidden_narrowings": []
      }
    ],
    "quantifiers": [
      {
        "variable": "ι",
        "kind": "forall",
        "domain": "Type u"
      },
      {
        "variable": "s",
        "kind": "forall",
        "domain": "Finset ι"
      },
      {
        "variable": "r",
        "kind": "forall",
        "domain": "ι → Nat"
      },
      {
        "variable": "k",
        "kind": "forall",
        "domain": "Nat"
      }
    ],
    "hypotheses": [
      {
        "id": "hyp-equality",
        "canonical": "A DecidableEq instance on the arbitrary index type permits finite-set difference; no numerical, positivity, nonempty-set, or degree hypothesis is assumed."
      }
    ],
    "conclusion": {
      "canonical": "The k coefficient of e993CenterProduct s r equals the sum over t in s.powerset of if t.card<=k then Nat.choose (sum_(i in s minus t) r(i)) (k-t.card) else 0. The cardinality guard is explicit; arbitrary natural k and exponents are included.",
      "clauses": [
        "The k coefficient of e993CenterProduct s r equals the sum over t in s.powerset of if t.card<=k then Nat.choose (sum_(i in s minus t) r(i)) (k-t.card) else 0. The cardinality guard is explicit; arbitrary natural k and exponents are included."
      ]
    },
    "lean_statement": "theorem e993_center_subset_coeff {ι : Type*} [DecidableEq ι]\n    (s : Finset ι) (r : ι → ℕ) (k : ℕ) :\n    (e993CenterProduct s r).coeff k =\n      ∑ t ∈ s.powerset,\n        if t.card ≤ k then (∑ i ∈ s \\ t, r i).choose (k - t.card) else 0",
    "permitted_axioms": [
      "Classical.choice",
      "Quot.sound",
      "propext"
    ],
