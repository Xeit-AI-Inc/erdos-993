  "theorem_contract": {
    "contract_id": "e993-any-strict-descent-rank-v1",
    "contract_sha256": "3d75ed4dd1d160b2652f1a221d779a2b84ddd9c81aad62b122c2df4a65a209e3",
    "theorem_name": "e993_rank_any_strict_descent",
    "definitions": [
      {
        "name": "def-parent",
        "canonical": "e993RankParent rs=(1+2*X)*(rs.map (fun r => (1+X)^r+X)).prod+X*(1+X)^(rs.sum+1), in Polynomial Rat. The exponent weight N+1 is not asserted to be the degree of P."
      }
    ],
    "domains": [
      {
        "variable": "rs",
        "lean_type": "List Nat",
        "forbidden_narrowings": []
      },
      {
        "variable": "k",
        "lean_type": "Nat",
        "forbidden_narrowings": []
      }
    ],
    "quantifiers": [
      {
        "variable": "rs",
        "kind": "forall",
        "domain": "List Nat"
      },
      {
        "variable": "k",
        "kind": "forall",
        "domain": "Nat"
      }
    ],
    "hypotheses": [
      {
        "id": "hyp-arity",
        "canonical": "Every r in rs is equal to 2, 3 or 4."
      },
      {
        "id": "hyp-drop",
        "canonical": "(e993RankParent rs).coeff (k+1) < (e993RankParent rs).coeff k for the given natural k. No first-descent minimality is assumed."
      }
    ],
    "conclusion": {
      "canonical": "2 * rs.sum <= 5 * k as an inequality of natural numbers. No log-concavity, extra positivity, cutoff, or graph interpretation is assumed.",
      "clauses": [
        "2 * rs.sum <= 5 * k as an inequality of natural numbers. No log-concavity, extra positivity, cutoff, or graph interpretation is assumed."
      ]
    },
    "lean_statement": "theorem e993_rank_any_strict_descent (rs : List ℕ)\n    (hr : ∀ r ∈ rs, r = 2 ∨ r = 3 ∨ r = 4) (k : ℕ)\n    (hdrop : (e993RankParent rs).coeff (k + 1) < (e993RankParent rs).coeff k) :\n    2 * rs.sum ≤ 5 * k",
    "permitted_axioms": [
      "Classical.choice",
      "Quot.sound",
      "propext"
    ],
    "constructivity_requirement": "classical_allowed",
