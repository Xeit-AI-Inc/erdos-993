ng_id":"e3872b60d60e42cf","message":"The current Lean theorem and e993RankParent definition match the exact contract: all finite arity-2/3/4 lists including empty and repeated entries, every natural strict coefficient descent with zero extension, rational polynomial coefficients, and natural conclusion 2*rs.sum <= 5*k. The proof adds no premise or encoding trick.","observed":"match","scope":"independent_review","severity":"note","source":"independent_reviewer"},{"category":"registration_whitespace","expected":"semantic fidelity","finding_id":"bf87188280d262c5","message":"Each of the two adapted definitions differs from its original proposal only by a newline between noncomputable and def; the registered tokens and theorem statement are unchanged.","observed":"match","scope":"independent_review","severity":"note","source":"independent_reviewer"},{"category":"spread_witness_metadata","expected":"semantic fidelity","finding_id":"6692634df2d75e6f","message":"The recorded normalized spread witness has m=23 and N=82, giving ordinary path-star order N+m+3=108. This supports proposed witness-order metadata without a global minimality claim or a status change.","observed":"match","scope":"independent_review","severity":"note","source":"independent_reviewer"}],"input_sha256":"6bc5338ca02483d62b69ae33559fd8a5a09228eb4c0fc45e78879fde09aa3b4b","kernel_receipt_sha256":"6e7ccbf50db3c363654d612a9372da354a818d040d554c1085cc5287c16b536b","lean_source_sha256":"2ca135236c2178f88235e54163a1ed09fee051e20075a8d901ac10cde76888d2","review_attestation":{"attestation_id":"C2-RANK-FIDELITY-20260928T063131Z-5b8e1f7c","completed_at":"2026-09-28T06:32:33Z","reviewer_id":"C2-RANK-FIDELITY","reviewer_kind":"independent-mathematical-formalization-fidelity-reviewer","verdict":"match"},"run_id":"lean-2026-09-28-c2-rank","schema_version":"formalization-fidelity-audit-receipt.v1","semantic_review_status":"passed","verdict":"passed"}
