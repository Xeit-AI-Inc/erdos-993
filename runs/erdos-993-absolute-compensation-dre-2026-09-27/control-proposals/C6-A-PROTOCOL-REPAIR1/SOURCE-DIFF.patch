+def invocation_controls() -> list[dict]:
+    """Controller protocol repair1: run exact required controls in every invocation."""
+    cases = [((0, 22, 0), 3, 27), ((38, 0, 1), 4, 77), ((1, 0, 0), 2, 1)]
+    out = []
+    for counts, r, k in cases:
+        n, h, m, q, c, e = profile(counts)
